# Ambiente: dev | test | prod
SVS_ENV=dev
# Banco: sqlite local (padrão) ou PostgreSQL em produção
SVS_DB_URL=sqlite+pysqlite:///./data/svs.db
# SVS_DB_URL=postgresql+psycopg://svs:svs@localhost:5432/svs

# Segredos — OBRIGATÓRIO trocar em produção (o app recusa iniciar em prod com os padrões)
SVS_CPF_PEPPER=troque-este-pepper
SVS_DRIVER_SECRET=troque-este-segredo-de-sessao
SVS_INGEST_KEY=chave-de-ingestao
SVS_ADMIN_KEY=chave-administrativa

# Regras de negócio
SVS_OFFLINE_AFTER=300          # segundos até considerar veículo offline
SVS_PUBLIC_RATE_LIMIT=60       # requisições por janela
SVS_PUBLIC_RATE_WINDOW=60      # janela em segundos
SVS_POSITION_DECIMALS=4        # ~11 m de precisão na resposta pública
SVS_AUTO_SEED=1                # popula dados sintéticos se o banco estiver vazio
SVS_CORS_ORIGINS=
